{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riscv-prg32/computer-architecture-with-prg32/tools/concepts/registry.schema.json",
  "title": "ARC12 concept progression registry",
  "type": "object",
  "required": ["concepts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "concepts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+\\.[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/concept" }
    }
  },
  "$defs": {
    "lecture": { "type": "string", "pattern": "^(0\\d|1\\d|2[0-4])$" },
    "concept": {
      "type": "object",
      "required": ["label", "intro", "use", "formal", "practice"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "object", "required": ["en", "it"], "additionalProperties": false,
          "properties": { "en": { "type": "string", "minLength": 1, "maxLength": 40 }, "it": { "type": "string", "minLength": 1, "maxLength": 40 } }
        },
        "intro": { "$ref": "#/$defs/lecture", "description": "lecture of first exposure (any badge)" },
        "use": { "description": "first lecture with a badge USE NOW or UNDERSTAND NOW", "oneOf": [{ "$ref": "#/$defs/lecture" }, { "type": "null" }] },
        "formal": { "description": "first lecture with a badge UNDERSTAND NOW; null if the course uses the concept and does not study it", "oneOf": [{ "$ref": "#/$defs/lecture" }, { "type": "null" }] },
        "practice": { "type": "array", "items": { "type": "string", "pattern": "^\\d\\d:\\d+$" }, "description": "questions and exercises that check the concept, lecture:slide of the specification" },
        "reason": { "type": "string", "description": "required when formal is null: why the concept stays operational" },
        "review": { "type": "string", "description": "needs-review: an issue found by the audit, to be decided by the author" }
      }
    }
  }
}
